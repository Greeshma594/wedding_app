# Copy this file to .env and fill in your values.
# Supabase: Project Settings → API Keys. Use the publishable (or "anon") key, never the secret/service key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Shown on the home screen and receipts.
EXPO_PUBLIC_SHOP_NAME=Bridal Rentals

# Your Google review link (Google Business Profile → Ask for reviews → copy link).
EXPO_PUBLIC_GOOGLE_REVIEW_URL=

# Currency symbol for prices and receipts.
EXPO_PUBLIC_CURRENCY_SYMBOL=₹
